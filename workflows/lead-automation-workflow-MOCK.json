        "jsonBody": "={{ JSON.stringify({filterGroups: [{filters: [{propertyName: \"phone\", operator: \"EQ\", value: $json.phone_normalized}]}, {filters: [{propertyName: \"email\", operator: \"EQ\", value: $json.email_normalized}]}], properties: [\"email\", \"phone\", \"firstname\", \"lastname\"], limit: 10}) }}"
