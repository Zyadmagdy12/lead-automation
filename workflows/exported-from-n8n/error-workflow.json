  "nodes": [
    {
      "id": "error-trigger",
      "name": "Error Trigger",
      "parameters": {},
      "position": [
        0,
        0
      ],
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1
    },
    {
      "id": "extract",
      "name": "Extract Error Info",
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const j = $input.first().json;\nconst execution = j.execution || {};\nconst workflow = j.workflow || {};\nconst err = j.error || execution.error || {};\nreturn [{ json: {\n  execution_id: String(execution.id || j.executionId || ''),\n  workflow_name: String(workflow.name || j.workflowName || ''),\n  failed_node: String((err.node && err.node.name) || j.nodeName || ''),\n  error_message: String((err.message) || j.message || 'unknown error').slice(0, 500),\n  stage_failed: 'error_trigger',\n  status: 'pending',\n  created_at: new Date().toISOString(),\n  lead_id: '', name: '', phone_normalized: '', email_normalized: '', product: '',\n  budget_egp: '', band: '', score: '', contact_id: '', deal_id: '', retry_count: '0'\n}}];\n"
      },
      "position": [
        200,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "prep-alert",
      "name": "Prepare Error Alert",
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const j = $input.first().json;\nreturn [{ json: { ...j, alert_text: 'Workflow error before lead was recorded. Execution ' + j.execution_id + ' in workflow ' + j.workflow_name + '. Error: ' + j.error_message + '. Recover the lead from the saved failed execution in n8n (Executions list).' } }];\n"
      },
      "position": [
        600,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
